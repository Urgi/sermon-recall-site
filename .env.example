# Copy this file to `.env.local` in this folder (`site/`) and fill in values.
# Never commit `.env.local`.

# Supabase — Dashboard → Project Settings → API (database/auth API host, NOT your pastor website)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Pastor admin website URL (where you open /login in the browser) — required for email confirmation links
# Production example: https://admin.sermonrecall.com  (different from SUPABASE_URL above)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: base URL encoded in member join QR codes (defaults to NEXT_PUBLIC_SITE_URL)
# Use if members should land on a different host, e.g. https://sermonrecall.com
# NEXT_PUBLIC_MEMBER_JOIN_URL=https://admin.sermonrecall.com

# Optional: public support / privacy contact (defaults to support@sermonrecall.com)
# NEXT_PUBLIC_SUPPORT_EMAIL=support@sermonrecall.com

# Server-only — required for notifying church members via Expo push after publish (bypasses RLS).
# SUPABASE_SERVICE_ROLE_KEY=

# If true, the pastor who sends a broadcast also receives the push (same account on web + phone demo).
# Default: omit sender from recipients.
# PASTOR_BROADCAST_INCLUDE_SENDER=true

# Hourly cron (spaced Day 1/3/6 + midday nudge). Set on Vercel + Authorization: Bearer <secret>.
# CRON_SECRET=

# OpenAI — server-side only (never NEXT_PUBLIC_*).
# Required for AI devotional generation. Optional fallback when Groq transcription fails.
# OPENAI_API_KEY=
# Optional transcription fallback model:
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Groq — primary sermon transcription (worker + optional sync fallback).
# GROQ_API_KEY=
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Optional ISO-639-1 hint (en, es, fr):
# GROQ_TRANSCRIPTION_LANGUAGE=

# Transcription worker (Railway/Fly — not Vercel): cd site && npm run worker:transcription
# Deploy 2 replicas at launch (~2 per 10 churches). Railway: worker/Dockerfile (ffmpeg + yt-dlp).
# Or Railpack: RAILPACK_DEPLOY_APT_PACKAGES=ffmpeg yt-dlp
# YouTube on Railway (required for reliable URL imports): see docs/youtube-worker-setup.md
# YT_DLP_COOKIES_BASE64=   # base64(Netscape cookies.txt) — preferred on Railway
# YT_DLP_COOKIES=           # or raw multiline Netscape cookies
# YT_DLP_COOKIES_FILE=/path/to/youtube-cookies.txt
# SUPABASE_SERVICE_ROLE_KEY=  (same as above)
# TRANSCRIPTION_WORKER_ID=worker-1
# WORKER_POLL_MS=2000

# Optional devotional model (defaults try gpt-4o-mini, then gpt-4.1-mini):
# OPENAI_DEVOTIONAL_MODEL=gpt-4o-mini

# Optional: App Store review bypass (fixed email + code, no inbox). Same vars as mobile EAS production.
# NEXT_PUBLIC_APP_REVIEW_EMAIL=apple-review@sermonrecall.com
# NEXT_PUBLIC_APP_REVIEW_CODE=482719

# Member app store links (Google Play defaults to package com.antoineassociates.sermonrecall).
# NEXT_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.antoineassociates.sermonrecall
# Set when App Store is live, e.g. https://apps.apple.com/app/id6798402169
# NEXT_PUBLIC_APP_STORE_URL=

# Admin portal public URL
# Production: https://admin.sermonrecall.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Firebase client (if using Firebase UI on web — rare for pastors-only admin)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
