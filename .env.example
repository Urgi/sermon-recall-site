# Copy this file to `.env.local` in this folder (`site/`) and fill in values.
# Never commit `.env.local`.

# Supabase — Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Server-only — required for notifying church members via Expo push after publish (bypasses RLS).
# SUPABASE_SERVICE_ROLE_KEY=

# If true, the pastor who sends a broadcast also receives the push (same account on web + phone demo).
# Default: omit sender from recipients.
# PASTOR_BROADCAST_INCLUDE_SENDER=true

# Hourly cron (spaced Day 1/3/6 + midday nudge). Set on Vercel + Authorization: Bearer <secret>.
# CRON_SECRET=

# OpenAI — server-side transcription (Whisper) for sermon audio/video uploads. Never NEXT_PUBLIC_*.
# OPENAI_API_KEY=
# Optional:
# OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Gemini — server-side only (admin generates devotionals). Never NEXT_PUBLIC_*.
# GEMINI_API_KEY=
# Optional override (defaults try gemini-2.5-flash, then lite, then gemini-flash-latest):
# GEMINI_MODEL=gemini-2.5-flash

# --- Later (admin portal / Edge — uncomment when wired) ---
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Firebase client (if using Firebase UI on web — rare for pastors-only admin)
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
